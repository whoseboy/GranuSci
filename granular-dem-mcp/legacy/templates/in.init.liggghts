# 自然堆积初始化：生成各 (d, F) 的 restart（论文2.1.2"系统初始化采用颗粒自然堆积"）
# 占位符（runner._gen_init 替换）：meshfile radius restart_out ins_ymax mass_in ninsert

echo            both
log             log.init

atom_style    granular
atom_modify   map array
boundary      f f f
newton        off

communicate   single vel yes

units         si

# 模拟域包住容器（容器 x[0,0.1] y[0,0.2] z[0,0.0045]，STL scale 0.001）
# y 向留足振动余量（ad最大4 → 网格摆幅±16mm，取±50mm余量）
region        domain block -0.005 0.105 -0.05 0.25 -0.005 0.010 units box
create_box    1 domain

# 方槽网格
fix   cad all mesh/surface file ${meshfile} type 1 scale 0.001
fix   walls all wall/gran model hertz tangential history mesh n_meshes 1 meshes cad

# 材料属性（论文表2.1）
fix  m1 all property/global youngsModulus peratomtype 5.e7
fix  m2 all property/global poissonsRatio peratomtype 0.45
fix  m3 all property/global coefficientRestitution peratomtypepair 1 0.95
fix  m4 all property/global coefficientFriction peratomtypepair 1 0.3
fix  m5 all property/global coefficientRollingFriction peratomtypepair 1 0.03

pair_style  gran model hertz tangential history rolling_friction epsd2 torsionTorque on
pair_coeff  * *

timestep    0.00001

fix gravi all gravity 9.81 vector 0.0 -1.0 0.0
fix integr all nve/sphere

thermo        10000
thermo_style  custom step atoms
thermo_modify lost ignore norm no

# 颗粒模板：单分散球（d=2*radius），密度 2500
fix pts all particletemplate/sphere 15485863 radius constant ${radius} density constant 2500
fix pdd all particledistribution/discrete 15485867 1 pts 1.0

# 插入区域：容器内部（x 留半径余量，z 全槽宽，y 高度按目标颗数反算）
region insreg block 0.003 0.097 0.005 ${ins_ymax} 0.0 0.0045 units box

# 插入：mass_in 控制总质量 -> 精确颗数
fix ins all insert/pack seed 32452843 distributiontemplate pdd maxattempt 100000 insert_every once overlapcheck yes all_in yes region insreg mass_in_region ${mass_in}

# 插入 + 沉降
run 400000
unfix ins
run 400000

write_restart ${restart_out}
