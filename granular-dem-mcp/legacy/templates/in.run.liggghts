# 振动工况运行脚本 —— 结构照抄已验证的 in.liggghts-原版
# 参数经命令行 -var 传入：restart meshfile amp period save run_dev run_stat
# 输出：${outdir}/dmp_*.txt（文本 dump，* 自动替换为时间步）

echo            both
log             log.liggghts

atom_style    granular
atom_modify   map array
boundary      f f f
newton        off

communicate   single vel yes

units         si

read_restart    ${restart}

neighbor      0.002 bin
neigh_modify  delay 0

# 材料属性（表2.1）
fix  m1 all property/global youngsModulus peratomtype 5.e7
fix  m2 all property/global poissonsRatio peratomtype 0.45
fix  m3 all property/global coefficientRestitution peratomtypepair 1 0.95
fix  m4 all property/global coefficientFriction peratomtypepair 1 0.3
fix  m5 all property/global coefficientRollingFriction peratomtypepair 1 0.03

pair_style  gran model hertz tangential history rolling_friction epsd2 torsionTorque on
pair_coeff  * *

timestep    0.00001

fix gravi all gravity 9.81 vector 0.0 -1.0 0.0

# 方槽网格 + 竖直正弦振动（y 向）
fix   cad all mesh/surface file ${meshfile} type 1 scale 0.001
fix   move all move/mesh mesh cad wiggle amplitude 0 ${amp} 0 period ${period}
fix   granwalls all wall/gran model hertz tangential history mesh n_meshes 1 meshes cad

fix    integr all nve/sphere

compute       rke all erotate/sphere
thermo_style  custom step atoms ke c_rke
thermo        100000
thermo_modify lost ignore norm no

# 发展段（统计前充分发展）
run ${run_dev}

# 统计段：dump 间隔 = 1/8 振动周期
dump dmp all custom ${save} ${outdir}/dmp_*.txt id type x y z vx vy vz omegax omegay omegaz radius
run ${run_stat}
