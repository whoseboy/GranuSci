# GranuSci 环境变量模板（复制为 .env 并填写实际值；.env 不入库）

# ---- LLM 推理服务（OpenAI 兼容接口）----
PARATERA_BASE_URL=
PARATERA_API_KEY=

# 国外模型经本地 OpenAI 兼容网关路由（可选）
HIGRESS_URL=
HIGRESS_KEY=

# ---- MCP 计算服务端点 ----
# 离散元批量仿真服务（granular-dem-mcp）
DEM_MCP_URL=http://localhost:8001/mcp
# 数据驱动量纲分析服务（DDDA-MCP）
DDDA_MCP_URL=http://localhost:8000/mcp
# 文献检索与引用登记服务（lit-mcp）
LITX_MCP_URL=http://localhost:8006/mcp

# ---- MCP 服务鉴权（可选；服务端设置 MCP_AUTH_TOKEN 时才需要）----
DEM_MCP_TOKEN=

# ---- 文献检索（可选；lit-mcp 的 Sciverse 检索腿）----
SCIVERSE_KEY=
